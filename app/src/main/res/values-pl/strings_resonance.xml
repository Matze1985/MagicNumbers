    <string name="resonance6_meaning_aaabbb">Wyraźna zmiana: faza A → faza B (zakończenie i nowy początek).</string>
    <string name="resonance6_meaning_aabbcc">Rozwój etapami – nauka i integracja krok po kroku.</string>

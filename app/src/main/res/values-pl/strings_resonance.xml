    <string name="resonance6_meaning_abcabc">Powracający temat – rutyna, pętla, uświadomienie poprzez powtórzenie.</string>
    <string name="resonance6_meaning_mirror">Sprzężenie zwrotne – zrozumienie poprzez odbicie (wewnątrz/zewnątrz).</string>

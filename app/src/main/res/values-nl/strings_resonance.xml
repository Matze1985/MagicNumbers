    <string name="resonance6_meaning_mono">Maximale versterking – één thema domineert sterk (zegen of fixatie).</string>
    <string name="resonance6_meaning_aaabbb">Duidelijke verschuiving: fase A → fase B (afronding en nieuw begin).</string>
    <string name="resonance6_meaning_aabbcc">Ontwikkeling in fasen – leren en integreren stap voor stap.</string>
    <string name="resonance6_meaning_ababab">Spanning tussen twee polen – vind balans, beslissing en ritme.</string>
    <string name="resonance6_meaning_abcabc">Terugkerend thema – routine, lus, bewustwording door herhaling.</string>
    <string name="resonance6_meaning_mirror">Feedback – inzicht door weerspiegeling (binnen/buiten).</string>
